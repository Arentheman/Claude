@inject IJSRuntime JS

<button type="button" class="btn btn-outline-secondary btn-sm theme-toggle" @onclick="Toggle" title="Переключить тему">
    @(isDark ? "☀️ Светлая" : "🌙 Тёмная")
</button>

@code {
    private bool isDark;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("dmaTheme.get");
            isDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task Toggle()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("dmaTheme.set", isDark ? "dark" : "light");
    }
}
