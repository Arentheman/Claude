@page "/campaigns/{Id:int}"
@rendermode InteractiveServer
@using DMA.Application.Campaigns
@using DMA.Application.Sessions
@using DMA.Application.Characters
@using DMA.Application.Encounters
@using DMA.Domain.Constants
@using DMA.Domain.Entities
@using DMA.Domain.Enums
@inject CampaignService CampaignService
@inject SessionService SessionService
@inject PlayerCharacterService CharacterService
@inject EncounterService EncounterService
@inject NavigationManager Nav

<PageTitle>@(campaign?.Name ?? "Кампания")</PageTitle>

@if (campaign is null)
{
    <p><em>@(loaded ? "Кампания не найдена." : "Загрузка...")</em></p>
}
else
{
    <a href="/">&larr; К списку кампаний</a>
    <h1>@campaign.Name</h1>

    <div class="section-card">
        <EditForm Model="campaign" OnValidSubmit="SaveCampaign" FormName="edit-campaign">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Статус</label>
                    <InputSelect class="form-select" @bind-Value="campaign.Status">
                        @foreach (var status in Enum.GetValues<CampaignStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-9">
                    <label class="form-label">Описание</label>
                    <InputTextArea class="form-control" @bind-Value="campaign.Description" rows="2" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm mt-3">Сохранить</button>
        </EditForm>
    </div>

    <div class="section-card">
        <h2>Сессии</h2>
        <table class="table table-sm">
            <thead><tr><th>#</th><th>Название</th><th>Дата</th><th></th></tr></thead>
            <tbody>
                @foreach (var session in sessions)
                {
                    <tr>
                        <td>@session.Number</td>
                        <td>@session.Title</td>
                        <td>@(session.PlayedOn?.ToString("d") ?? "-")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="@($"/campaigns/{Id}/sessions/{session.Id}")">Открыть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <EditForm Model="newSessionTitle" OnValidSubmit="CreateSession" FormName="new-session" class="d-flex gap-2">
            <InputText class="form-control" @bind-Value="newSessionTitle.Value" placeholder="Название новой сессии" />
            <button type="submit" class="btn btn-success text-nowrap" disabled="@string.IsNullOrWhiteSpace(newSessionTitle.Value)">+ Сессия</button>
        </EditForm>
    </div>

    <div class="section-card">
        <h2>Персонажи игроков</h2>
        <p class="text-secondary small">Быстрая панель на сессию — HP, AC и состояния меняются прямо здесь, без захода в лист персонажа.</p>
        <div class="row g-3 mb-3">
            @foreach (var pc in characters)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 character-card">
                        <div class="card-body">
                            <div class="d-flex gap-3 align-items-center mb-2">
                                @if (!string.IsNullOrEmpty(pc.PortraitPath))
                                {
                                    <img class="avatar-circle" src="@($"/uploads/{pc.PortraitPath}")" alt="@pc.Name" />
                                }
                                else
                                {
                                    <div class="avatar-circle-placeholder">@Initials(pc.Name)</div>
                                }
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@pc.Name</div>
                                    <div class="text-secondary small">@pc.Race @pc.Class, ур. @pc.Level</div>
                                </div>
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/campaigns/{Id}/characters/{pc.Id}")">Лист</a>
                            </div>

                            <div class="d-flex gap-2 align-items-center mb-2">
                                <div class="input-group input-group-sm" style="max-width:140px">
                                    <span class="input-group-text">HP</span>
                                    <input type="number" min="0" class="form-control" value="@pc.CurrentHp"
                                           @onchange="@(e => UpdateHp(pc, e.Value))" />
                                    <span class="input-group-text">/@pc.MaxHp</span>
                                </div>
                                <div class="input-group input-group-sm" style="max-width:100px">
                                    <span class="input-group-text">AC</span>
                                    <input type="number" min="0" class="form-control" value="@pc.ArmorClass"
                                           @onchange="@(e => UpdateAc(pc, e.Value))" />
                                </div>
                            </div>

                            <div>
                                @foreach (var c in pc.Conditions)
                                {
                                    <span class="badge bg-info text-dark me-1 mb-1" role="button" @onclick="() => ToggleCondition(pc, c)">@c &times;</span>
                                }
                                <select class="form-select form-select-sm d-inline-block w-auto" @onchange="@(e => AddCondition(pc, e.Value?.ToString()))">
                                    <option value="">+ состояние</option>
                                    @foreach (var c in Dnd5eConditions.All.Where(c => !pc.Conditions.Contains(c)))
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <a class="btn btn-success" href="@($"/campaigns/{Id}/characters/0")">+ Персонаж</a>
    </div>

    <div class="section-card">
        <h2>Столкновения</h2>
        <table class="table table-sm">
            <thead><tr><th>Название</th><th>Статус</th><th></th></tr></thead>
            <tbody>
                @foreach (var enc in encounters)
                {
                    <tr>
                        <td>@enc.Name</td>
                        <td><span class="badge bg-@EncounterBadge(enc.Status)">@enc.Status</span></td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="@($"/campaigns/{Id}/encounters/{enc.Id}")">Открыть</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEncounter(enc.Id)">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <EditForm Model="newEncounterName" OnValidSubmit="CreateEncounter" FormName="new-encounter" class="d-flex gap-2">
            <InputText class="form-control" @bind-Value="newEncounterName.Value" placeholder="Название нового столкновения" />
            <button type="submit" class="btn btn-success text-nowrap" disabled="@string.IsNullOrWhiteSpace(newEncounterName.Value)">+ Столкновение</button>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Campaign? campaign;
    private List<Session> sessions = [];
    private List<PlayerCharacter> characters = [];
    private List<Encounter> encounters = [];
    private TextModel newSessionTitle = new();
    private TextModel newEncounterName = new();
    private bool loaded;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        campaign = await CampaignService.GetByIdAsync(Id);
        if (campaign is null)
        {
            loaded = true;
            return;
        }
        sessions = await SessionService.GetByCampaignAsync(Id);
        characters = await CharacterService.GetByCampaignAsync(Id);
        encounters = await EncounterService.GetByCampaignAsync(Id);
        loaded = true;
    }

    private async Task SaveCampaign()
    {
        if (campaign is not null)
            await CampaignService.UpdateAsync(campaign);
    }

    private async Task CreateSession()
    {
        var session = await SessionService.CreateAsync(Id, newSessionTitle.Value);
        Nav.NavigateTo($"/campaigns/{Id}/sessions/{session.Id}");
    }

    private async Task CreateEncounter()
    {
        var encounter = await EncounterService.CreateAsync(Id, newEncounterName.Value, null);
        Nav.NavigateTo($"/campaigns/{Id}/encounters/{encounter.Id}");
    }

    private async Task DeleteEncounter(int encounterId)
    {
        await EncounterService.DeleteAsync(encounterId);
        encounters = await EncounterService.GetByCampaignAsync(Id);
    }

    private async Task UpdateHp(PlayerCharacter pc, object? value)
    {
        if (int.TryParse(value?.ToString(), out var hp))
        {
            await CharacterService.UpdateHpAsync(pc.Id, hp);
            characters = await CharacterService.GetByCampaignAsync(Id);
        }
    }

    private async Task UpdateAc(PlayerCharacter pc, object? value)
    {
        if (int.TryParse(value?.ToString(), out var ac))
        {
            await CharacterService.UpdateArmorClassAsync(pc.Id, ac);
            characters = await CharacterService.GetByCampaignAsync(Id);
        }
    }

    private async Task ToggleCondition(PlayerCharacter pc, string condition)
    {
        await CharacterService.ToggleConditionAsync(pc.Id, condition);
        characters = await CharacterService.GetByCampaignAsync(Id);
    }

    private async Task AddCondition(PlayerCharacter pc, string? condition)
    {
        if (!string.IsNullOrWhiteSpace(condition))
        {
            await CharacterService.ToggleConditionAsync(pc.Id, condition);
            characters = await CharacterService.GetByCampaignAsync(Id);
        }
    }

    private static string EncounterBadge(EncounterStatus status) => status switch
    {
        EncounterStatus.Planned => "secondary",
        EncounterStatus.Active => "danger",
        EncounterStatus.Completed => "success",
        _ => "light"
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private class TextModel
    {
        public string Value { get; set; } = string.Empty;
    }
}
