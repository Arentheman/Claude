@page "/campaigns/{CampaignId:int}/characters/{Id:int}"
@rendermode InteractiveServer
@using DMA.Application.Characters
@using DMA.Domain.Entities
@using DMA.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject PlayerCharacterService CharacterService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(character?.Name ?? "Новый персонаж")</PageTitle>

@if (character is null)
{
    <p><em>@(loaded ? "Персонаж не найден." : "Загрузка...")</em></p>
}
else
{
    <a href="@($"/campaigns/{CampaignId}")">&larr; К кампании</a>
    <h1>@(IsNew ? "Новый персонаж" : character.Name)</h1>

    <div class="section-card">
        <EditForm Model="character" OnValidSubmit="Save" FormName="edit-character">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small" />
            <div class="row mb-3">
                <div class="col-auto text-center">
                    @if (!IsNew)
                    {
                        <div id="portrait-paste-zone" tabindex="0" class="paste-zone mb-2">
                            @if (!string.IsNullOrEmpty(character.PortraitPath))
                            {
                                <img class="avatar-circle avatar-circle-lg d-block mb-2" src="@($"/uploads/{character.PortraitPath}")" alt="@character.Name" />
                            }
                            else
                            {
                                <div class="avatar-circle-lg-placeholder mb-2">@Initials(character.Name)</div>
                            }
                            <InputFile OnChange="OnPortraitSelected" class="form-control form-control-sm" accept="image/*" />
                            <div class="text-secondary small mt-1">Кликните и Ctrl+V, или выберите файл</div>
                        </div>
                    }
                    else
                    {
                        <div class="avatar-circle-lg-placeholder mb-2">?</div>
                        <div class="text-secondary small" style="max-width:120px">Портрет можно добавить после сохранения</div>
                    }
                </div>
                <div class="col">
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label">Имя персонажа</label>
                            <InputText class="form-control" @bind-Value="character.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Игрок</label>
                            <InputText class="form-control" @bind-Value="character.PlayerName" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Раса</label>
                            <InputText class="form-control" @bind-Value="character.Race" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Класс</label>
                            <InputText class="form-control" @bind-Value="character.Class" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Уровень</label>
                            <InputNumber class="form-control" @bind-Value="character.Level" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">HP текущее</label>
                            <InputNumber class="form-control" @bind-Value="character.CurrentHp" min="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">HP максимум</label>
                            <InputNumber class="form-control" @bind-Value="character.MaxHp" min="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">AC</label>
                            <InputNumber class="form-control" @bind-Value="character.ArmorClass" min="0" />
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3">
                    <h5>Характеристики</h5>
                    <div class="ability-stack">
                        <div class="ability-box">
                            <span class="ability-label">Сила</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Strength" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Ловкость</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Dexterity" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Телосложение</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Constitution" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Интеллект</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Intelligence" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Мудрость</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Wisdom" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Харизма</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="character.Abilities.Charisma" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <h5>Заметки</h5>
                    <InputTextArea class="form-control h-100" @bind-Value="character.Notes" rows="10" />
                </div>
            </div>

            <hr />

            <h5>Кошелёк</h5>
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="form-label">ММ (медные)</label>
                    <InputNumber class="form-control" @bind-Value="character.Currency.CopperPieces" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">СМ (серебряные)</label>
                    <InputNumber class="form-control" @bind-Value="character.Currency.SilverPieces" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ЭМ (электрум)</label>
                    <InputNumber class="form-control" @bind-Value="character.Currency.ElectrumPieces" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ЗМ (золотые)</label>
                    <InputNumber class="form-control" @bind-Value="character.Currency.GoldPieces" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ПМ (платиновые)</label>
                    <InputNumber class="form-control" @bind-Value="character.Currency.PlatinumPieces" min="0" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
            @if (!IsNew)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="Delete">Удалить персонажа</button>
            }
        </EditForm>
    </div>

    @if (!IsNew)
    {
        <div class="section-card">
            <h2>Заклинания и способности</h2>
            @if (character.Features.Count > 0)
            {
                <table class="table table-sm">
                    <thead><tr><th>Название</th><th>Тип</th><th>Ур.</th><th>Описание</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in character.Features.OrderBy(f => f.Type).ThenBy(f => f.Level).ThenBy(f => f.Name))
                        {
                            <tr>
                                <td>@f.Name</td>
                                <td><span class="badge bg-@(f.Type == CharacterFeatureType.Spell ? "info" : "secondary")">@(f.Type == CharacterFeatureType.Spell ? "Заклинание" : "Способность")</span></td>
                                <td>@(f.Type == CharacterFeatureType.Spell ? (f.Level == 0 ? "Заговор" : f.Level?.ToString()) : "")</td>
                                <td class="text-break">@f.Description</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFeature(f.Id)">Удалить</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <EditForm Model="newFeature" OnValidSubmit="AddFeature" FormName="add-feature">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Название</label>
                        <InputText class="form-control" @bind-Value="newFeature.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Тип</label>
                        <InputSelect class="form-select" @bind-Value="newFeature.Type">
                            <option value="@CharacterFeatureType.Ability">Способность</option>
                            <option value="@CharacterFeatureType.Spell">Заклинание</option>
                        </InputSelect>
                    </div>
                    @if (newFeature.Type == CharacterFeatureType.Spell)
                    {
                        <div class="col-md-1">
                            <label class="form-label">Ур.</label>
                            <InputNumber class="form-control" @bind-Value="newFeature.Level" min="0" max="9" />
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label">Описание</label>
                        <InputText class="form-control" @bind-Value="newFeature.Description" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success" disabled="@string.IsNullOrWhiteSpace(newFeature.Name)">+ Добавить</button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="section-card">
            <h2>Инвентарь</h2>
            @foreach (var category in Enum.GetValues<InventoryItemCategory>())
            {
                var items = character.Inventory.Where(i => i.Category == category).ToList();
                @if (items.Count > 0)
                {
                    <h6 class="text-secondary">@CategoryLabel(category)</h6>
                    <table class="table table-sm mb-3">
                        <thead><tr><th>Предмет</th><th>Кол-во</th><th>Заметки</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td style="width:100px">
                                        <input type="number" min="0" class="form-control form-control-sm" value="@item.Quantity"
                                               @onchange="@(e => UpdateItemQuantity(item, e.Value))" />
                                    </td>
                                    <td>@item.Notes</td>
                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItem(item.Id)">Удалить</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            <EditForm Model="newItem" OnValidSubmit="AddItem" FormName="add-item">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Название</label>
                        <InputText class="form-control" @bind-Value="newItem.Name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Категория</label>
                        <InputSelect class="form-select" @bind-Value="newItem.Category">
                            @foreach (var category in Enum.GetValues<InventoryItemCategory>())
                            {
                                <option value="@category">@CategoryLabel(category)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Кол-во</label>
                        <InputNumber class="form-control" @bind-Value="newItem.Quantity" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Заметки</label>
                        <InputText class="form-control" @bind-Value="newItem.Notes" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success" disabled="@string.IsNullOrWhiteSpace(newItem.Name)">+ Добавить</button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="section-card">
            <h2>Картинки и скриншоты</h2>
            @if (character.Attachments.Count > 0)
            {
                <div class="row g-3 mb-3">
                    @foreach (var att in character.Attachments)
                    {
                        <div class="col-md-3">
                            <img class="attachment-thumb mb-1" src="@($"/uploads/{att.StoredFileName}")" alt="@att.Caption" />
                            <div class="small text-truncate">@att.Caption</div>
                            <button class="btn btn-sm btn-outline-danger mt-1" @onclick="() => RemoveAttachment(att.Id)">Удалить</button>
                        </div>
                    }
                </div>
            }
            <div id="attachment-paste-zone" tabindex="0" class="paste-zone">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Файл</label>
                        <InputFile OnChange="OnAttachmentSelected" class="form-control" accept="image/*" />
                        <div class="text-secondary small mt-1">Кликните сюда и вставьте (Ctrl+V) скриншот, или выберите файл</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Подпись</label>
                        <input class="form-control" @bind="newAttachmentCaption" />
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int CampaignId { get; set; }
    [Parameter] public int Id { get; set; }

    private bool IsNew => Id == 0;
    private PlayerCharacter? character;
    private bool loaded;
    private NewItemModel newItem = new();
    private NewFeatureModel newFeature = new();
    private string newAttachmentCaption = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsNew)
        {
            await JS.InvokeVoidAsync("dmaPasteUpload.register", "portrait-paste-zone");
            await JS.InvokeVoidAsync("dmaPasteUpload.register", "attachment-paste-zone");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        character = IsNew
            ? new PlayerCharacter { CampaignId = CampaignId }
            : await CharacterService.GetByIdAsync(Id);
        loaded = true;
    }

    private async Task Reload() => character = await CharacterService.GetByIdAsync(Id);

    private async Task Save()
    {
        if (character is null) return;

        if (IsNew)
        {
            var created = await CharacterService.CreateAsync(character);
            Nav.NavigateTo($"/campaigns/{CampaignId}/characters/{created.Id}");
        }
        else
        {
            await CharacterService.UpdateAsync(character);
        }
    }

    private async Task Delete()
    {
        await CharacterService.DeleteAsync(Id);
        Nav.NavigateTo($"/campaigns/{CampaignId}");
    }

    private async Task AddItem()
    {
        await CharacterService.AddInventoryItemAsync(Id, newItem.Name, newItem.Quantity, newItem.Notes, newItem.Category);
        newItem = new();
        await Reload();
    }

    private async Task RemoveItem(int itemId)
    {
        await CharacterService.RemoveInventoryItemAsync(itemId);
        await Reload();
    }

    private async Task UpdateItemQuantity(InventoryItem item, object? value)
    {
        if (int.TryParse(value?.ToString(), out var qty))
        {
            await CharacterService.UpdateInventoryItemQuantityAsync(item.Id, qty);
            await Reload();
        }
    }

    private async Task AddFeature()
    {
        await CharacterService.AddFeatureAsync(Id, newFeature.Name, newFeature.Type, newFeature.Level, newFeature.Description);
        newFeature = new();
        await Reload();
    }

    private async Task RemoveFeature(int featureId)
    {
        await CharacterService.RemoveFeatureAsync(featureId);
        await Reload();
    }

    // Full-resolution screenshots (e.g. a pasted 4K desktop capture) can run well past a
    // few MB as PNG; these ceilings just guard against pathological uploads, not normal ones.
    private const long MaxPortraitSize = 15 * 1024 * 1024;
    private const long MaxAttachmentSize = 30 * 1024 * 1024;

    private async Task OnPortraitSelected(InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(maxAllowedSize: MaxPortraitSize);
        await CharacterService.SetPortraitAsync(Id, stream, e.File.Name);
        await Reload();
    }

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(maxAllowedSize: MaxAttachmentSize);
        await CharacterService.AddAttachmentAsync(Id, stream, e.File.Name, e.File.ContentType, newAttachmentCaption);
        newAttachmentCaption = string.Empty;
        await Reload();
    }

    private async Task RemoveAttachment(int attachmentId)
    {
        await CharacterService.RemoveAttachmentAsync(attachmentId);
        await Reload();
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private static string CategoryLabel(InventoryItemCategory category) => category switch
    {
        InventoryItemCategory.Equipment => "Снаряжение",
        InventoryItemCategory.Consumable => "Расходники",
        InventoryItemCategory.Treasure => "Ценности",
        InventoryItemCategory.Misc => "Прочее",
        _ => category.ToString()
    };

    private class NewItemModel
    {
        public string Name { get; set; } = string.Empty;

        [Range(0, int.MaxValue, ErrorMessage = "Количество не может быть отрицательным.")]
        public int Quantity { get; set; } = 1;

        public string Notes { get; set; } = string.Empty;
        public InventoryItemCategory Category { get; set; } = InventoryItemCategory.Equipment;
    }

    private class NewFeatureModel
    {
        public string Name { get; set; } = string.Empty;
        public CharacterFeatureType Type { get; set; } = CharacterFeatureType.Ability;

        [Range(0, 9, ErrorMessage = "Уровень заклинания от 0 (заговор) до 9.")]
        public int? Level { get; set; }

        public string Description { get; set; } = string.Empty;
    }
}
