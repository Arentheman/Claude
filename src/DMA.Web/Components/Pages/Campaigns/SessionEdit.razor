@page "/campaigns/{CampaignId:int}/sessions/{Id:int}"
@rendermode InteractiveServer
@using DMA.Application.Sessions
@using DMA.Domain.Entities
@inject SessionService SessionService

<PageTitle>@(session?.Title ?? "Сессия")</PageTitle>

@if (session is null)
{
    <p><em>@(loaded ? "Сессия не найдена." : "Загрузка...")</em></p>
}
else
{
    <a href="@($"/campaigns/{CampaignId}")">&larr; К кампании</a>
    <h1>Сессия @session.Number: @session.Title</h1>

    <EditForm Model="session" OnValidSubmit="Save" FormName="edit-session">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Название</label>
                <InputText class="form-control" @bind-Value="session.Title" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Дата проведения</label>
                <InputDate class="form-control" @bind-Value="session.PlayedOn" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Что произошло (можно показывать игрокам)</label>
            <InputTextArea class="form-control" @bind-Value="session.Summary" rows="6" />
        </div>

        <div class="mb-3">
            <label class="form-label">Приватные заметки мастера (секреты, крючки, план на следующий раз)</label>
            <InputTextArea class="form-control" @bind-Value="session.MasterNotes" rows="6" />
        </div>

        <button type="submit" class="btn btn-primary">Сохранить</button>
        <button type="button" class="btn btn-outline-danger" @onclick="Delete">Удалить сессию</button>
    </EditForm>
}

@code {
    [Parameter] public int CampaignId { get; set; }
    [Parameter] public int Id { get; set; }

    private Session? session;
    private bool loaded;

    [Inject] private NavigationManager Nav { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        session = await SessionService.GetByIdAsync(Id);
        loaded = true;
    }

    private async Task Save()
    {
        if (session is not null)
            await SessionService.UpdateAsync(session);
    }

    private async Task Delete()
    {
        await SessionService.DeleteAsync(Id);
        Nav.NavigateTo($"/campaigns/{CampaignId}");
    }
}
