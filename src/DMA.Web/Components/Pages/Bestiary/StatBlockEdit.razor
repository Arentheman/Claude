@page "/bestiary/{Id:int}"
@rendermode InteractiveServer
@using DMA.Application.Bestiary
@using DMA.Domain.Entities
@using DMA.Domain.Enums
@inject StatBlockService StatBlockService
@inject NavigationManager Nav

<PageTitle>@(statBlock?.Name ?? "Новый монстр/NPC")</PageTitle>

@if (statBlock is null)
{
    <p><em>@(loaded ? "Запись бестиария не найдена." : "Загрузка...")</em></p>
}
else
{
    <a href="/bestiary">&larr; К бестиарию</a>
    <h1>@(IsNew ? "Новый монстр/NPC" : statBlock.Name)</h1>

    <div class="section-card">
        <EditForm Model="statBlock" OnValidSubmit="Save" FormName="edit-statblock">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small" />
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Имя</label>
                    <InputText class="form-control" @bind-Value="statBlock.Name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Тип</label>
                    <InputSelect class="form-select" @bind-Value="statBlock.Type">
                        @foreach (var t in Enum.GetValues<StatBlockType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Challenge Rating</label>
                    <InputText class="form-control" @bind-Value="statBlock.ChallengeRating" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Источник</label>
                    <InputText class="form-control" @bind-Value="statBlock.Source" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">HP</label>
                    <InputNumber class="form-control" @bind-Value="statBlock.MaxHp" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">AC</label>
                    <InputNumber class="form-control" @bind-Value="statBlock.ArmorClass" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Скорость</label>
                    <InputText class="form-control" @bind-Value="statBlock.Speed" />
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3">
                    <h5>Характеристики</h5>
                    <div class="ability-stack">
                        <div class="ability-box">
                            <span class="ability-label">Сила</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Strength" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Ловкость</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Dexterity" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Телосложение</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Constitution" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Интеллект</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Intelligence" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Мудрость</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Wisdom" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                        <div class="ability-box">
                            <span class="ability-label">Харизма</span>
                            <InputNumber class="form-control form-control-sm w-auto" style="max-width:80px" @bind-Value="statBlock.Abilities.Charisma" min="@AbilityScores.MinScore" max="@AbilityScores.MaxScore" />
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <h5>Описание / способности</h5>
                    <InputTextArea class="form-control h-100" @bind-Value="statBlock.Description" rows="10" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
            @if (!IsNew)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="Delete">Удалить</button>
            }
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool IsNew => Id == 0;
    private StatBlock? statBlock;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        statBlock = IsNew ? new StatBlock() : await StatBlockService.GetByIdAsync(Id);
        loaded = true;
    }

    private async Task Save()
    {
        if (statBlock is null) return;

        if (IsNew)
        {
            var created = await StatBlockService.CreateAsync(statBlock);
            Nav.NavigateTo($"/bestiary/{created.Id}");
        }
        else
        {
            await StatBlockService.UpdateAsync(statBlock);
        }
    }

    private async Task Delete()
    {
        await StatBlockService.DeleteAsync(Id);
        Nav.NavigateTo("/bestiary");
    }
}
