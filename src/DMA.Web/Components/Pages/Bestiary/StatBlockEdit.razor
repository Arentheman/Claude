@page "/bestiary/{Id:int}"
@rendermode InteractiveServer
@using DMA.Application.Bestiary
@using DMA.Domain.Entities
@using DMA.Domain.Enums
@inject StatBlockService StatBlockService
@inject NavigationManager Nav

<PageTitle>@(statBlock?.Name ?? "Новый монстр/NPC")</PageTitle>

@if (statBlock is null)
{
    <p><em>@(loaded ? "Запись бестиария не найдена." : "Загрузка...")</em></p>
}
else
{
    <a href="/bestiary">&larr; К бестиарию</a>
    <h1>@(IsNew ? "Новый монстр/NPC" : statBlock.Name)</h1>

    <EditForm Model="statBlock" OnValidSubmit="Save" FormName="edit-statblock">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Имя</label>
                <InputText class="form-control" @bind-Value="statBlock.Name" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Тип</label>
                <InputSelect class="form-select" @bind-Value="statBlock.Type">
                    @foreach (var t in Enum.GetValues<StatBlockType>())
                    {
                        <option value="@t">@t</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-2">
                <label class="form-label">Challenge Rating</label>
                <InputText class="form-control" @bind-Value="statBlock.ChallengeRating" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Источник</label>
                <InputText class="form-control" @bind-Value="statBlock.Source" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">HP</label>
                <InputNumber class="form-control" @bind-Value="statBlock.MaxHp" />
            </div>
            <div class="col-md-3">
                <label class="form-label">AC</label>
                <InputNumber class="form-control" @bind-Value="statBlock.ArmorClass" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Скорость</label>
                <InputText class="form-control" @bind-Value="statBlock.Speed" />
            </div>
        </div>

        <h5>Характеристики</h5>
        <div class="row mb-3">
            <div class="col">
                <label class="form-label">Сила</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Strength" />
            </div>
            <div class="col">
                <label class="form-label">Ловкость</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Dexterity" />
            </div>
            <div class="col">
                <label class="form-label">Телосложение</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Constitution" />
            </div>
            <div class="col">
                <label class="form-label">Интеллект</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Intelligence" />
            </div>
            <div class="col">
                <label class="form-label">Мудрость</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Wisdom" />
            </div>
            <div class="col">
                <label class="form-label">Харизма</label>
                <InputNumber class="form-control" @bind-Value="statBlock.Abilities.Charisma" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Описание / способности</label>
            <InputTextArea class="form-control" @bind-Value="statBlock.Description" rows="4" />
        </div>

        <button type="submit" class="btn btn-primary">Сохранить</button>
        @if (!IsNew)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="Delete">Удалить</button>
        }
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool IsNew => Id == 0;
    private StatBlock? statBlock;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        statBlock = IsNew ? new StatBlock() : await StatBlockService.GetByIdAsync(Id);
        loaded = true;
    }

    private async Task Save()
    {
        if (statBlock is null) return;

        if (IsNew)
        {
            var created = await StatBlockService.CreateAsync(statBlock);
            Nav.NavigateTo($"/bestiary/{created.Id}");
        }
        else
        {
            await StatBlockService.UpdateAsync(statBlock);
        }
    }

    private async Task Delete()
    {
        await StatBlockService.DeleteAsync(Id);
        Nav.NavigateTo("/bestiary");
    }
}
