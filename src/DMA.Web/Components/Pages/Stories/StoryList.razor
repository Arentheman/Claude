@page "/stories"
@rendermode InteractiveServer
@using DMA.Application.Stories
@using DMA.Domain.Entities
@inject StoryService StoryService
@inject NavigationManager Nav

<PageTitle>Сюжеты</PageTitle>

<h1>Сюжеты</h1>
<p class="text-secondary">Пишите сюжет здесь один раз, а затем привязывайте его к любым кампаниям — каждая кампания получает свою независимую копию.</p>

@if (stories is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    @if (stories.Count == 0)
    {
        <p class="text-muted">Пока нет ни одного сюжета. Создайте первый ниже.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var story in stories)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@story.Name</h5>
                            <p class="card-text text-truncate">@story.Description</p>
                            <a class="btn btn-primary btn-sm" href="@($"/stories/{story.Id}")">Открыть</a>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteStory(story.Id)">Удалить</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<h2>Новый сюжет</h2>
<EditForm Model="newStory" OnValidSubmit="CreateStory" FormName="new-story">
    <div class="mb-2">
        <label class="form-label">Название</label>
        <InputText class="form-control" @bind-Value="newStory.Name" />
    </div>
    <div class="mb-2">
        <label class="form-label">Описание</label>
        <InputTextArea class="form-control" @bind-Value="newStory.Description" rows="3" />
    </div>
    <button type="submit" class="btn btn-success" disabled="@string.IsNullOrWhiteSpace(newStory.Name)">Создать</button>
</EditForm>

@code {
    private List<Story>? stories;
    private NewStoryModel newStory = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => stories = await StoryService.GetAllAsync();

    private async Task CreateStory()
    {
        var story = await StoryService.CreateAsync(newStory.Name, newStory.Description);
        Nav.NavigateTo($"/stories/{story.Id}");
    }

    private async Task DeleteStory(int id)
    {
        await StoryService.DeleteAsync(id);
        await Load();
    }

    private class NewStoryModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
