@using DMA.Domain.Entities

<div class="story-tree-node">
    <div class="story-tree-row @(Node.Id == SelectedId ? "story-tree-row-selected" : "")" @onclick="() => OnSelect.InvokeAsync(Node.Id)">
        <span>@Node.Title</span>
        <span class="story-tree-row-actions">
            <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Добавить дочерний узел"
                    @onclick:stopPropagation="true" @onclick="() => OnAddChild.InvokeAsync(Node.Id)">+</button>
            <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Удалить узел и вложенные"
                    @onclick:stopPropagation="true" @onclick="() => OnDelete.InvokeAsync(Node.Id)">&times;</button>
        </span>
    </div>
    @if (Node.Children.Count > 0)
    {
        <div class="story-tree-children">
            @foreach (var child in Node.Children.OrderBy(c => c.SortOrder))
            {
                <StoryTreeNode Node="child" SelectedId="SelectedId" OnSelect="OnSelect" OnAddChild="OnAddChild" OnDelete="OnDelete" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public StoryNode Node { get; set; } = null!;
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback<int> OnAddChild { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
}
