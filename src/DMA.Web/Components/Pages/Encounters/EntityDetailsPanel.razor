@using DMA.Application.Characters
@using DMA.Application.Bestiary
@using DMA.Domain.Constants
@using DMA.Domain.Entities
@using DMA.Domain.Enums
@inject PlayerCharacterService CharacterService
@inject StatBlockService StatBlockService

@if (Participant is not null)
{
    <div class="entity-panel @(isCollapsed ? "entity-panel-collapsed" : "")">
        <div class="entity-panel-header">
            @if (!isCollapsed)
            {
                <span class="fw-semibold text-truncate">@Participant.Name</span>
            }
            <div class="entity-panel-header-actions">
                <button class="btn btn-sm btn-outline-secondary" title="@(isCollapsed ? "Развернуть" : "Свернуть")" @onclick="ToggleCollapsed">
                    @(isCollapsed ? "«" : "»")
                </button>
                @if (!isCollapsed)
                {
                    <button class="btn btn-sm btn-outline-secondary" title="Закрыть" @onclick="() => OnClose.InvokeAsync()">&times;</button>
                }
            </div>
        </div>

        @if (isCollapsed)
        {
            <div class="entity-panel-collapsed-label" role="button" @onclick="ToggleCollapsed">@Participant.Name</div>
        }
        else
        {
            <div class="entity-panel-body">
                <div class="d-flex gap-3 align-items-center mb-3">
                    @if (!string.IsNullOrEmpty(character?.PortraitPath))
                    {
                        <img class="avatar-circle-lg" src="@($"/uploads/{character.PortraitPath}")" alt="@Participant.Name" />
                    }
                    else
                    {
                        <div class="avatar-circle-lg-placeholder">@Initials(Participant.Name)</div>
                    }
                    <div>
                        <div class="fs-5 fw-semibold">@Participant.Name</div>
                        <span class="badge bg-secondary">@SourceTypeLabel()</span>
                        @if (character is not null)
                        {
                            <div class="text-secondary small mt-1">@CharacterSubtitle(character)</div>
                        }
                        @if (statBlock is not null)
                        {
                            <div class="text-secondary small mt-1">@statBlock.ChallengeRating ⋅ @statBlock.Speed ⋅ @statBlock.Source</div>
                        }
                    </div>
                </div>

                <div class="entity-panel-vitals mb-3">
                    <div class="entity-vital-box">
                        <div class="entity-vital-label">HP</div>
                        <div class="entity-vital-value">@Participant.CurrentHp / @Participant.MaxHp</div>
                        <div class="progress" style="height:0.4rem">
                            <div class="progress-bar bg-@HpBarColor()" style="width:@(HpPercent())%"></div>
                        </div>
                    </div>
                    <div class="entity-vital-box">
                        <div class="entity-vital-label">AC</div>
                        <div class="entity-vital-value">@Participant.ArmorClass</div>
                    </div>
                </div>

                @if (Abilities is { } abilities)
                {
                    <div class="entity-ability-grid mb-3">
                        @foreach (var (label, score) in new[]
                        {
                            ("СИЛ", abilities.Strength), ("ЛОВ", abilities.Dexterity), ("ТЕЛ", abilities.Constitution),
                            ("ИНТ", abilities.Intelligence), ("МДР", abilities.Wisdom), ("ХАР", abilities.Charisma)
                        })
                        {
                            <div class="entity-ability-box">
                                <div class="entity-ability-label">@label</div>
                                <div class="entity-ability-score">@score</div>
                                <div class="entity-ability-mod">@FormatModifier(AbilityScores.Modifier(score))</div>
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <div class="text-secondary small mb-1">Состояния</div>
                    @foreach (var c in Participant.Conditions)
                    {
                        <ConditionBadge Key="@c" Removable="true" OnRemove="() => OnRemoveCondition.InvokeAsync(c)" />
                    }
                    <select class="form-select form-select-sm d-inline-block w-auto mt-1" @onchange="@(e => AddCondition(e.Value?.ToString()))">
                        <option value="">+ состояние</option>
                        @foreach (var c in Dnd5eConditions.All.Where(c => !Participant.Conditions.Contains(c)))
                        {
                            <option value="@c">@Dnd5eConditions.NameRu(c)</option>
                        }
                    </select>
                </div>

                @if (character is not null)
                {
                    <div class="mb-3">
                        <div class="text-secondary small mb-1">Кошелёк</div>
                        <div>@CurrencyLine(character.Currency)</div>
                    </div>

                    @if (character.Inventory.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="text-secondary small mb-1">Инвентарь</div>
                            @foreach (var group in character.Inventory.GroupBy(i => i.Category).OrderBy(g => g.Key))
                            {
                                <div class="fw-semibold small mt-2">@CategoryLabel(group.Key)</div>
                                <ul class="entity-panel-list">
                                    @foreach (var item in group)
                                    {
                                        <li>@item.Name @(item.Quantity > 1 ? $"×{item.Quantity}" : "")</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    @if (character.Features.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="text-secondary small mb-1">Способности и заклинания</div>
                            <ul class="entity-panel-list">
                                @foreach (var feature in character.Features)
                                {
                                    <li>
                                        <span class="fw-semibold">@feature.Name</span>
                                        <span class="badge bg-@(feature.Type == CharacterFeatureType.Spell ? "info" : "secondary") ms-1">
                                            @(feature.Type == CharacterFeatureType.Spell ? (feature.Level == 0 ? "Заговор" : $"Ур. {feature.Level}") : "Способность")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(feature.Description))
                                        {
                                            <div class="text-secondary small">@feature.Description</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(character.Notes))
                    {
                        <div class="mb-3">
                            <div class="text-secondary small mb-1">Заметки</div>
                            <div class="entity-panel-notes">@character.Notes</div>
                        </div>
                    }
                }

                @if (statBlock is not null && !string.IsNullOrWhiteSpace(statBlock.Description))
                {
                    <div class="mb-3">
                        <div class="text-secondary small mb-1">Описание</div>
                        <div class="entity-panel-notes">@statBlock.Description</div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public EncounterParticipant? Participant { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRemoveCondition { get; set; }
    [Parameter] public EventCallback<string> OnAddCondition { get; set; }

    private bool isCollapsed;
    private PlayerCharacter? character;
    private StatBlock? statBlock;
    private int? loadedForParticipantId;

    protected override async Task OnParametersSetAsync()
    {
        if (Participant is null)
        {
            character = null;
            statBlock = null;
            loadedForParticipantId = null;
            return;
        }

        if (loadedForParticipantId == Participant.Id) return;
        loadedForParticipantId = Participant.Id;
        isCollapsed = false;
        character = null;
        statBlock = null;

        if (Participant.SourceType == ParticipantSourceType.PlayerCharacter && Participant.SourceId is int pcId)
            character = await CharacterService.GetByIdAsync(pcId);
        else if (Participant.SourceType == ParticipantSourceType.StatBlock && Participant.SourceId is int sbId)
            statBlock = await StatBlockService.GetByIdAsync(sbId);
    }

    private AbilityScores? Abilities => character?.Abilities ?? statBlock?.Abilities;

    private void ToggleCollapsed() => isCollapsed = !isCollapsed;

    private Task AddCondition(string? condition) =>
        string.IsNullOrWhiteSpace(condition) ? Task.CompletedTask : OnAddCondition.InvokeAsync(condition);

    private int HpPercent() => Participant!.MaxHp > 0 ? Math.Clamp(Participant.CurrentHp * 100 / Participant.MaxHp, 0, 100) : 0;

    private string HpBarColor()
    {
        var pct = HpPercent();
        return pct >= 50 ? "success" : pct >= 25 ? "warning" : "danger";
    }

    private string SourceTypeLabel() => Participant!.SourceType switch
    {
        ParticipantSourceType.PlayerCharacter => "Игрок",
        ParticipantSourceType.StatBlock => statBlock?.Type == StatBlockType.Npc ? "NPC" : "Монстр",
        _ => "Особый участник"
    };

    private static string FormatModifier(int mod) => mod >= 0 ? $"+{mod}" : mod.ToString();

    private static string CharacterSubtitle(PlayerCharacter c)
    {
        var raceClass = $"{c.Race} {c.Class}".Trim();
        return string.IsNullOrEmpty(raceClass) ? $"Ур. {c.Level}" : $"{raceClass}, ур. {c.Level}";
    }

    private static string CategoryLabel(InventoryItemCategory category) => category switch
    {
        InventoryItemCategory.Equipment => "Снаряжение",
        InventoryItemCategory.Consumable => "Расходники",
        InventoryItemCategory.Treasure => "Ценности",
        InventoryItemCategory.Misc => "Прочее",
        _ => category.ToString()
    };

    private static string CurrencyLine(Currency currency)
    {
        var parts = new List<string>();
        if (currency.PlatinumPieces > 0) parts.Add($"{currency.PlatinumPieces} ПМ");
        if (currency.GoldPieces > 0) parts.Add($"{currency.GoldPieces} ЗМ");
        if (currency.ElectrumPieces > 0) parts.Add($"{currency.ElectrumPieces} ЭМ");
        if (currency.SilverPieces > 0) parts.Add($"{currency.SilverPieces} СМ");
        if (currency.CopperPieces > 0) parts.Add($"{currency.CopperPieces} ММ");
        return parts.Count > 0 ? string.Join(" · ", parts) : "—";
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }
}
