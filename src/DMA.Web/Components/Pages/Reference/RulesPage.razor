@page "/reference/rules"
@rendermode InteractiveServer
@using DMA.Application.Common.Interfaces
@using DMA.Domain.Reference
@inject IReferenceDataService ReferenceData

<PageTitle>Правила — Справочник</PageTitle>

<a href="/reference">&larr; К справочнику</a>
<h1>Правила</h1>

<div class="mb-3">
    <input class="form-control" placeholder="Поиск по правилам..." @bind="query" @bind:event="oninput" />
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="section-card">
            @if (!string.IsNullOrWhiteSpace(query))
            {
                var results = ReferenceData.SearchRules(query);
                @if (results.Count == 0)
                {
                    <p class="text-secondary small">Ничего не найдено.</p>
                }
                else
                {
                    @foreach (var hit in results)
                    {
                        <div class="story-tree-row @(hit.Id == selectedId ? "story-tree-row-selected" : "")" @onclick="() => Select(hit.Id)">
                            <span>@hit.Title</span>
                        </div>
                    }
                }
            }
            else
            {
                @foreach (var root in tree)
                {
                    <RuleOutlineNode Node="root" SelectedId="selectedId" OnSelect="Select" />
                }
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="section-card">
            @if (selected is null)
            {
                <p class="text-secondary">Выберите раздел слева.</p>
            }
            else
            {
                <h4>@selected.Title</h4>
                @foreach (var paragraph in selected.Content.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph</p>
                }
                @foreach (var table in selected.Tables)
                {
                    @if (!string.IsNullOrWhiteSpace(table.Title))
                    {
                        <h6>@table.Title</h6>
                    }
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    @foreach (var col in table.Columns)
                                    {
                                        <th>@col</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in table.Rows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td>@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<RuleSectionNode> tree = [];
    private string? selectedId;
    private RuleSection? selected;
    private string query = "";

    protected override void OnInitialized() => tree = ReferenceData.GetRuleTree();

    private void Select(string id)
    {
        selectedId = id;
        selected = ReferenceData.GetRuleSection(id);
    }
}
